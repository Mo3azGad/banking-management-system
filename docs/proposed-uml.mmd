classDiagram
  %% PROPOSED final design. Milestone 5 has Bank opening/retrieval, deposits/withdrawals/history and freezing; transfers and interest remain planned.
  class Bank {
    +registerCustomer(id, name) Customer
    +findCustomer(id) Customer
    +getCustomers() List
    +openCheckingAccount(...)
    +openSavingsAccount(...)
    +findAccount(id) Account
    +getAccounts() List
    +transfer(sourceId, targetId, amount, date)
  }
  class Customer {
    -String id
    -String name
  }
  class Account {
    <<abstract>>
    -BigDecimal balance
    -boolean frozen
    +deposit(amount, date)
    +withdraw(amount, date)
    +applyMonthlyInterest(date)
    +freeze()
    +isFrozen() bool
    +getTransactionHistory() List
    #minimumBalance() BigDecimal
  }
  class CheckingAccount
  class SavingsAccount
  class Transaction
  class InterestPolicy {
    <<interface>>
    +calculate(balance) BigDecimal
  }
  class FixedRateInterestPolicy
  class BankingException {
    <<abstract>>
  }
  class InvalidBankingInputException
  class DuplicateCustomerException
  class CustomerNotFoundException
  class InsufficientFundsException
  class AccountFrozenException
  class DuplicateAccountException
  class AccountNotFoundException
  class InvalidPostingDateException
  Bank "1" *-- "0..*" Customer : registry
  Bank "1" *-- "0..*" Account : registry
  Account "0..*" --> "1" Customer : owner
  Account "1" *-- "0..*" Transaction : history
  Account --> InterestPolicy
  Account <|-- CheckingAccount
  Account <|-- SavingsAccount
  InterestPolicy <|.. FixedRateInterestPolicy
  BankingException <|-- InvalidBankingInputException
  BankingException <|-- DuplicateCustomerException
  BankingException <|-- AccountFrozenException
  BankingException <|-- DuplicateAccountException
  BankingException <|-- AccountNotFoundException
  BankingException <|-- InsufficientFundsException
  BankingException <|-- InvalidPostingDateException
  BankingException <|-- CustomerNotFoundException
