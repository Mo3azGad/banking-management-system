digraph UML {
graph [rankdir=TB, bgcolor="white", pad=0.18, nodesep=0.32, ranksep=0.55, splines=polyline, fontname="Helvetica", fontsize=16, labelloc=t, label=<<B>Banking Management System | Domain view</B><BR/><FONT POINT-SIZE="10">20 November 2026 • selected members; signatures / legend in UML_GUIDE.md</FONT>>];
node [shape=plain, fontname="Helvetica", fontsize=10];
edge [fontname="Helvetica", fontsize=9, color="#46576B", arrowsize=0.75, labeldistance=1.8];
Bank [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#B7C4D1"><TR><TD BGCOLOR="#203B58"><FONT COLOR="white"><B>Bank</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- customers:<BR ALIGN="LEFT"/>  Map&lt;String, Customer&gt;<BR ALIGN="LEFT"/>- accounts:<BR ALIGN="LEFT"/>  Map&lt;String, Account&gt;<BR ALIGN="LEFT"/>- lastTransferReference: long<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ registerCustomer(...)<BR ALIGN="LEFT"/>+ findCustomer(...)<BR ALIGN="LEFT"/>+ getCustomers()<BR ALIGN="LEFT"/>+ openCheckingAccount(...)<BR ALIGN="LEFT"/>+ openSavingsAccount(...)<BR ALIGN="LEFT"/>+ findAccount(...)<BR ALIGN="LEFT"/>+ getAccounts()<BR ALIGN="LEFT"/>+ transfer(...)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Customer [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#B7C4D1"><TR><TD BGCOLOR="#203B58"><FONT COLOR="white"><B>Customer</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id: String<BR ALIGN="LEFT"/>- name: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Customer(id, name)<BR ALIGN="LEFT"/>+ getId(): String<BR ALIGN="LEFT"/>+ getName(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Account [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#B7C4D1"><TR><TD BGCOLOR="#203B58"><FONT COLOR="white"><B>Account {abstract}</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id: String<BR ALIGN="LEFT"/>- owner: Customer<BR ALIGN="LEFT"/>- interestPolicy: InterestPolicy<BR ALIGN="LEFT"/>- ledger: LedgerState<BR ALIGN="LEFT"/>- frozen: boolean<BR ALIGN="LEFT"/>- openedOn: LocalDate<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getBalance(): BigDecimal<BR ALIGN="LEFT"/>+ getAvailableBalance()<BR ALIGN="LEFT"/>+ isFrozen(): boolean<BR ALIGN="LEFT"/>+ freeze(): void<BR ALIGN="LEFT"/>+ deposit(...)<BR ALIGN="LEFT"/>+ withdraw(...)<BR ALIGN="LEFT"/>+ applyMonthlyInterest(...)<BR ALIGN="LEFT"/>+ getTransactionHistory()<BR ALIGN="LEFT"/><I>+ getMinimumBalance()</I><BR ALIGN="LEFT"/><I>+ getMonthlyInterestRate()</I><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
CheckingAccount [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#B7C4D1"><TR><TD BGCOLOR="#203B58"><FONT COLOR="white"><B>CheckingAccount</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- MINIMUM_BALANCE = 0.00<BR ALIGN="LEFT"/>- MONTHLY_RATE = 0.001<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getMinimumBalance()<BR ALIGN="LEFT"/>+ getMonthlyInterestRate()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
SavingsAccount [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#B7C4D1"><TR><TD BGCOLOR="#203B58"><FONT COLOR="white"><B>SavingsAccount</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- MINIMUM_BALANCE = 100.00<BR ALIGN="LEFT"/>- MONTHLY_RATE = 0.003<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getMinimumBalance()<BR ALIGN="LEFT"/>+ getMonthlyInterestRate()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
InterestPolicy [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#B7C4D1"><TR><TD BGCOLOR="#226D71"><FONT COLOR="white"><B>InterestPolicy<BR/>«interface»</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ calculate(balance)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
FixedRateInterestPolicy [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#B7C4D1"><TR><TD BGCOLOR="#226D71"><FONT COLOR="white"><B>FixedRateInterestPolicy</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- monthlyRate: BigDecimal<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ calculate(balance)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Transaction [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#B7C4D1"><TR><TD BGCOLOR="#203B58"><FONT COLOR="white"><B>«record» Transaction</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id: long<BR ALIGN="LEFT"/>- accountId: String<BR ALIGN="LEFT"/>- type: TransactionType<BR ALIGN="LEFT"/>- amount: BigDecimal<BR ALIGN="LEFT"/>- balanceAfter: BigDecimal<BR ALIGN="LEFT"/>- date: LocalDate<BR ALIGN="LEFT"/>- transferReference:<BR ALIGN="LEFT"/>  OptionalLong<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Transaction(all components)<BR ALIGN="LEFT"/>+ component accessors<BR ALIGN="LEFT"/>{all components readOnly}<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
TransactionType [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#B7C4D1"><TR><TD BGCOLOR="#203B58"><FONT COLOR="white"><B>TransactionType<BR/>«enumeration»</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">OPENING<BR ALIGN="LEFT"/>DEPOSIT<BR ALIGN="LEFT"/>WITHDRAWAL<BR ALIGN="LEFT"/>TRANSFER_IN<BR ALIGN="LEFT"/>TRANSFER_OUT<BR ALIGN="LEFT"/>INTEREST<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
{rank=same; TransactionType; Bank; Customer;}
{rank=same; Transaction; Account; InterestPolicy;}
{rank=same; CheckingAccount; SavingsAccount; FixedRateInterestPolicy;}
TransactionType -> Bank -> Customer [style=invis, weight=10];
Transaction -> Account -> InterestPolicy [style=invis, weight=10];
CheckingAccount -> SavingsAccount -> FixedRateInterestPolicy [style=invis, weight=10];
Bank -> Account [style=invis, weight=10];
Customer -> InterestPolicy [style=invis];
Account -> CheckingAccount [style=invis, weight=10];
Account -> SavingsAccount [style=invis, weight=10];
InterestPolicy -> FixedRateInterestPolicy [style=invis, weight=10];
TransactionType -> Transaction [style=invis];
Bank -> Customer [arrowhead="vee", taillabel="0..1", headlabel="0..*", constraint="false"];
Bank -> Account [arrowhead="vee", taillabel="0..1", headlabel="0..*", constraint="false"];
Account -> Customer [arrowhead="vee", label="owner", taillabel="0..*", headlabel="1", constraint="false"];
Account -> InterestPolicy [arrowhead="vee", taillabel="0..*", headlabel="1", constraint="false"];
CheckingAccount -> Account [arrowhead="empty", constraint="false"];
SavingsAccount -> Account [arrowhead="empty", constraint="false"];
FixedRateInterestPolicy -> InterestPolicy [arrowhead="empty", style="dashed", constraint="false"];
Account -> Transaction [arrowhead="vee", style="dashed", constraint="false"];
Transaction -> TransactionType [arrowhead="vee", headlabel="1", constraint="false"];
}
